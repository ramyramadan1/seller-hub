APP_NAME="Seller Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Central database. This MySQL/PostgreSQL user needs the CREATE DATABASE privilege:
# every store gets its own database named tenant_{id}.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=seller_hub
DB_USERNAME=root
DB_PASSWORD=

# Queue/cache/session tables are CENTRAL (they must never follow the active tenant).
QUEUE_CONNECTION=database
CACHE_STORE=file
SESSION_DRIVER=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Use CACHE_STORE=redis (and REDIS_*) to enable per-store cache tagging.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum token lifetime in minutes (default 14 days)
SANCTUM_EXPIRATION=20160

# Free credits granted to every new store
SELLER_TRIAL_CREDITS=10

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
